                    <!-- Items -->
                    <Grid x:Name="ItemView" Visibility="Collapsed">
                        <GroupBox Header="Item Editor">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Text="Clean item.ini editor. Select an item on the left, edit the known item fields on the right, then save. Blank fields are skipped. Checked flags write bare INI flags."
                                   Opacity="0.75"
                                   Margin="0,0,0,8" />

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="620" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0" Header="Items" Margin="0,0,12,0">
                                        <DockPanel Margin="8">
                                            <TextBox x:Name="ItemSearchBox"
                                                 DockPanel.Dock="Top"
                                                 Height="28"
                                                 Margin="0,0,0,8"
                                                 TextChanged="ItemSearchBox_TextChanged"
                                                 ToolTip="Search items by ID, name, class, subtype, animation, size, burden, or value" />

                                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                                <Button Content="New / Next ID"
                                                    Height="30"
                                                    Margin="0,0,0,6"
                                                    Click="NewItemButton_Click" />
                                                <Button Content="Delete Selected"
                                                    Height="30"
                                                    Click="DeleteItemButton_Click" />
                                            </StackPanel>

                                            <DataGrid x:Name="ItemListGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  SelectionMode="Single"
                                                  SelectionChanged="ItemListGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="70" />
                                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                                                    <DataGridTextColumn Header="Class" Binding="{Binding Class}" Width="110" />
                                                    <DataGridTextColumn Header="SubType" Binding="{Binding SubType}" Width="110" />
                                                    <DataGridTextColumn Header="Animation0" Binding="{Binding Animation0}" Width="90" />
                                                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90" />
                                                    <DataGridTextColumn Header="Burden" Binding="{Binding Burden}" Width="80" />
                                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="80" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1" Header="Selected Item Fields">
                                        <DockPanel Margin="8">
                                            <TextBlock x:Name="SelectedItemText"
                                               DockPanel.Dock="Top"
                                               Text="No item selected."
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                            <Border DockPanel.Dock="Top"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="1"
                                                Padding="8"
                                                Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Button Content="Commit / Save Item"
                                                        Width="150"
                                                        Height="28"
                                                        DockPanel.Dock="Right"
                                                        Click="CommitItemButton_Click" />

                                                    <TextBlock Text="Edit fields, then commit to item.ini."
                                                       VerticalAlignment="Center"
                                                       Opacity="0.75" />
                                                </DockPanel>
                                            </Border>

                                            <Grid DockPanel.Dock="Bottom"
                                                  Margin="0,8,0,0"
                                                  MinHeight="170">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="430" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Expander Grid.Column="0"
                                                      Header="INI Preview"
                                                      IsExpanded="True">
                                                    <TextBox x:Name="ItemRawPreviewText"
                                                         FontFamily="Consolas"
                                                         FontSize="13"
                                                         IsReadOnly="True"
                                                         TextWrapping="NoWrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         MinHeight="140" />
                                                </Expander>

                                                <GroupBox Grid.Column="2"
                                                    Header="Sprite Preview">
                                                    <DockPanel Margin="8">
                                                        <StackPanel DockPanel.Dock="Top"
                                                            Orientation="Horizontal"
                                                            Margin="0,0,0,8">
                                                            <TextBlock Text="Mode:"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,6,0" />

                                                            <ComboBox x:Name="ItemSpritePreviewModeCombo"
                                                              Width="150"
                                                              SelectedIndex="0"
                                                              SelectionChanged="ItemSpritePreviewModeCombo_SelectionChanged">
                                                                <ComboBoxItem Content="Composite" />
                                                                <ComboBoxItem Content="Animation Fields" />
                                                                <ComboBoxItem Content="Combined" />
                                                            </ComboBox>
                                                        </StackPanel>

                                                        <TextBlock x:Name="ItemSpritePreviewText"
                                                           DockPanel.Dock="Bottom"
                                                           Text="Preview IDs: -"
                                                           Margin="0,8,0,0"
                                                           Opacity="0.75" />

                                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                                VerticalScrollBarVisibility="Disabled">
                                                            <StackPanel x:Name="ItemSpritePreviewStrip"
                                                                Orientation="Horizontal"
                                                                VerticalAlignment="Center" />
                                                        </ScrollViewer>
                                                    </DockPanel>
                                                </GroupBox>
                                            </Grid>

                                            <TabControl x:Name="ItemFieldTabs">
                                                <TabItem Header="Base">
                                                    <DataGrid x:Name="ItemBaseFieldGrid"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column">
                                                        <DataGrid.Columns>
                                                            <DataGridTextColumn Header="Field" Binding="{Binding Label}" IsReadOnly="True" Width="180" />
                                                            <DataGridTemplateColumn Header="Value" Width="*">
                                                                <DataGridTemplateColumn.CellTemplate>
                                                                    <DataTemplate>
                                                                        <ComboBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding Options}"
                                                              IsEditable="True" />
                                                                    </DataTemplate>
                                                                </DataGridTemplateColumn.CellTemplate>
                                                            </DataGridTemplateColumn>
                                                            <DataGridTextColumn Header="INI Key" Binding="{Binding IniKey}" IsReadOnly="True" Width="140" />
                                                        </DataGrid.Columns>
                                                    </DataGrid>
                                                </TabItem>

                                                <TabItem Header="General">
                                                    <DataGrid x:Name="ItemGeneralFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Equipment">
                                                    <DataGrid x:Name="ItemEquipmentFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Animations">
                                                    <DataGrid x:Name="ItemAnimationsFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Armor">
                                                    <DataGrid x:Name="ItemArmorFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Weapon">
                                                    <DataGrid x:Name="ItemWeaponFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Growth">
                                                    <DataGrid x:Name="ItemGrowthFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Food">
                                                    <DataGrid x:Name="ItemFoodFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Bonus">
                                                    <DataGrid x:Name="ItemBonusFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Skill">
                                                    <DataGrid x:Name="ItemSkillFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Trader">
                                                    <DataGrid x:Name="ItemTraderFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Mobs">
                                                    <DataGrid x:Name="ItemMobsFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Proximity">
                                                    <DataGrid x:Name="ItemProximityFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Misc">
                                                    <DataGrid x:Name="ItemMiscFieldGrid" />
                                                </TabItem>
                                            </TabControl>
                                        </DockPanel>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>

