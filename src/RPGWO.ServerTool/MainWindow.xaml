                                                DockPanel.Dock="Top"
                                                Text="No monster selected."
                                                FontWeight="SemiBold"
                                                Margin="0,0,0,8" />

                                            <Border DockPanel.Dock="Top"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="1"
                                                Padding="8"
                                                Margin="0,0,0,8">
