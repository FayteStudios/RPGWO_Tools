<Window x:Class="RPGWO_INI_Tools.SpriteSheetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sprite Sheet Editor"
        Width="1800"
        Height="950"
        MinWidth="1700"
        MinHeight="820"
        Background="#D9D9D9">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Sprite Sheet Editor"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Content="Reload Sprite Archive"
                    DockPanel.Dock="Right"
                    Padding="10,4"
                    Click="ReloadSpriteArchive_Click"/>
        </DockPanel>

        <!-- Main Panels -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="820"/>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="760"/>
            </Grid.ColumnDefinitions>

            <!-- Active Sheet -->
            <GroupBox Grid.Column="0"
                      Header="Open Sprite Sheet"
                      Width="820"
                      Margin="0,0,8,0"
                      Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="SheetInfoText"
                               Text="No sheet selected."
                               Foreground="#444444"
                               Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <UniformGrid x:Name="SpriteGridPanel"
                                     Columns="10"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <!-- Library -->
            <GroupBox Grid.Column="1"
                      Header="Sprite Archive"
                      Margin="0,0,8,0"
                      Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Type" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TypeCombo"
                                  SelectionChanged="TypeCombo_SelectionChanged"/>
                    </StackPanel>

                    <TextBlock x:Name="SourceCountText"
                               Grid.Row="1"
                               Foreground="#444444"
                               Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SourceButtonsPanel"/>
                    </ScrollViewer>
                </Grid>
            </GroupBox>

            <!-- Queue -->
            <GroupBox Grid.Column="2"
                      Header="Output Queue"
                      Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Output Name" Margin="0,0,0,4"/>
                        <TextBox x:Name="OutputNameTextBox"
                                 Text="new_items"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1"
                                 Columns="5"
                                 Margin="0,0,0,8">
                        <Button Content="Up"
                                Click="MoveUp_Click"
                                Margin="0,0,3,0"/>

                        <Button Content="Down"
                                Click="MoveDown_Click"
                                Margin="3,0"/>

                        <Button Content="Remove"
                                Click="RemoveSelected_Click"
                                Margin="3,0"/>

                        <Button Content="Clear"
                                Click="ClearQueue_Click"
                                Margin="3,0"/>

                        <Button Content="Generate"
                                Click="GenerateSheet_Click"
                                Margin="3,0,0,0"/>
                    </UniformGrid>

                    <ScrollViewer Grid.Row="2"
                      Margin="0,8,0,0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
                                <UniformGrid x:Name="QueuePreviewPanel"
                         Columns="10"
                         Width="720"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"/>
                    </ScrollViewer>
                </Grid>
            </GroupBox>
        </Grid>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Text="Ready."
                   Margin="0,8,0,0"
                   Foreground="#202020"/>
    </Grid>
</Window>