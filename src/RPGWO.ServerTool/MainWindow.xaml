                                                       VerticalAlignment="Center"
                                                       Opacity="0.75" />
                                                </DockPanel>
                                            </Border>

                                            <Expander Header="Raw INI Entry"
                                              IsExpanded="False"
                                              DockPanel.Dock="Bottom"
                                              Margin="0,8,0,0">
