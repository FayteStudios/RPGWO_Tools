                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single"
                                                      SelectionChanged="MonsterListGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID"
                                                                        Binding="{Binding Id}"
                                                                        Width="70" />
                                                    <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name}"
                                                                        Width="*" />
                                                    <DataGridTextColumn Header="Flags"
                                                                        Binding="{Binding FlagCount}"
                                                                        Width="70" />
                                                    <DataGridTextColumn Header="Issues"
                                                                        Binding="{Binding IssueCount}"
                                                                        Width="70" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1"
                                              Header="Selected Monster Fields">
