<Window x:Class="RPGWO.ServerTool.MainWindow"
        WindowState="Maximized"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RPGWO Server Tool"
        Height="980"
        Width="1840"
        MinHeight="680"
        MinWidth="1040">

    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="RPGWO Server Tool"
                       FontSize="28"
                       FontWeight="SemiBold" />

            <TextBlock Text="Open a server folder, validate INI files, export CSVs, and edit server data."
                       Margin="0,4,0,12"
                       Opacity="0.75" />

            <DockPanel>
                <Button x:Name="OpenFolderButton"
                        Content="Open Server Folder"
                        Width="170"
                        Height="34"
                        Click="OpenFolderButton_Click"
                        DockPanel.Dock="Left" />

                <Button x:Name="SaveButton"
                        Content="Save"
                        Width="90"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="SaveButton_Click"
                        DockPanel.Dock="Left"
                        IsEnabled="False" />

                <Button x:Name="ExportCsvButton"
                        Content="Export Selected CSV"
                        Width="160"
                        Height="34"
                        Margin="8,0,0,0"
                        Click="ExportCsvButton_Click"
                        DockPanel.Dock="Left"
                        IsEnabled="False" />
                <Button Content="Sprite Sheet Editor"
                        Width="160"
                        Height="34"
                        Margin="8,4,0,4"
                        Click="OpenSpriteSheetEditor_Click"/>

                <TextBlock x:Name="ServerFolderText"
                           Text="No folder selected"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="#DDDDDD"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="Navigation"
                               FontWeight="SemiBold"
                               Margin="4,0,0,8" />

                    <ListBox x:Name="NavigationList"
                             SelectionChanged="NavigationList_SelectionChanged">
                        <ListBoxItem Content="Dashboard"
                                     Tag="Dashboard" />
                        <ListBoxItem Content="World"
                                     Tag="World"
                                     IsEnabled="False" />
                        <ListBoxItem Content="Skills"
                                     Tag="Skills"
                                     IsEnabled="False" />
                        <ListBoxItem Content="Animations"
                                     Tag="Animations"
                                     IsEnabled="False" />
                        <ListBoxItem Content="Treasures"
                                     Tag="Treasures"
                                     IsEnabled="False" />
                        <ListBoxItem Content="Magic"
                                     Tag="Magic"
                                     IsEnabled="False" />
                        <ListBoxItem Content="Monsters"
                                     Tag="Monsters"
                                     IsEnabled="False" />
                        <ListBoxItem Content="Items"
                                     Tag="Items"
                                     IsEnabled="False" />
                        <ListBoxItem Content="Item Uses"
                                     Tag="Usages"
                                     IsEnabled="False" />
                        <ListBoxItem Content="Multi Uses"
                                     Tag="MultiUses"
                                     IsEnabled="False" />
                    </ListBox>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <!-- Dashboard -->
                    <Grid x:Name="DashboardView">
                        <GroupBox Header="Server File Status">
                            <DataGrid x:Name="StatusGrid"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionChanged="StatusGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File"
                                                        Binding="{Binding DisplayName}"
                                                        Width="150" />
                                    <DataGridTextColumn Header="INI"
                                                        Binding="{Binding FileName}"
                                                        Width="120" />
                                    <DataGridTextColumn Header="Status"
                                                        Binding="{Binding StatusText}"
                                                        Width="100" />
                                    <DataGridTextColumn Header="Entries"
                                                        Binding="{Binding EntryCount}"
                                                        Width="80" />
                                    <DataGridTextColumn Header="Unknowns"
                                                        Binding="{Binding UnknownCount}"
                                                        Width="90" />
                                    <DataGridTextColumn Header="Issues"
                                                        Binding="{Binding IssueCount}"
                                                        Width="70" />
                                    <DataGridTextColumn Header="Summary"
                                                        Binding="{Binding Summary}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>

                    <!-- World -->
                    <Grid x:Name="WorldView"
      Visibility="Collapsed">
                        <GroupBox Header="World Editor">
                            <DockPanel Margin="8">
                                <TextBlock DockPanel.Dock="Top"
                       Text="Edit world.ini settings and flags, then commit changes back to world.ini."
                       Opacity="0.75"
                       Margin="0,0,0,8" />

                                <Border DockPanel.Dock="Top"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1"
                    Padding="8"
                    Margin="0,0,0,8">
                                    <DockPanel>
                                        <Button Content="Commit / Save World"
                            Width="160"
                            Height="28"
                            DockPanel.Dock="Right"
                            Click="CommitWorldButton_Click" />

                                        <TextBlock Text="Enabled / Flag controls whether the row writes to world.ini."
                               VerticalAlignment="Center"
                               Opacity="0.75" />
                                    </DockPanel>
                                </Border>

                                <Expander Header="Raw world.ini"
                      IsExpanded="False"
                      DockPanel.Dock="Bottom"
                      Margin="0,8,0,0">
                                    <TextBox x:Name="WorldRawPreviewText"
                         FontFamily="Consolas"
                         FontSize="13"
                         IsReadOnly="True"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         MinHeight="120"
                         MaxHeight="220" />
                                </Expander>

                                <TabControl>
                                    <TabItem Header="General">
                                        <DataGrid x:Name="WorldGeneralGrid" />
                                    </TabItem>

                                    <TabItem Header="Map">
                                        <DataGrid x:Name="WorldMapGrid" />
                                    </TabItem>

                                    <TabItem Header="Player">
                                        <DataGrid x:Name="WorldPlayerGrid" />
                                    </TabItem>

                                    <TabItem Header="Mob">
                                        <DataGrid x:Name="WorldMobGrid" />
                                    </TabItem>

                                    <TabItem Header="Item">
                                        <DataGrid x:Name="WorldItemGrid" />
                                    </TabItem>

                                    <TabItem Header="Guild">
                                        <DataGrid x:Name="WorldGuildGrid" />
                                    </TabItem>

                                    <TabItem Header="CTF">
                                        <DataGrid x:Name="WorldCtfGrid" />
                                    </TabItem>

                                    <TabItem Header="Misc">
                                        <DataGrid x:Name="WorldMiscGrid" />
                                    </TabItem>
                                </TabControl>
                            </DockPanel>
                        </GroupBox>
                    </Grid>

                    <!-- Skills -->
                    <Grid x:Name="SkillView"
                        Visibility="Collapsed">
                        <GroupBox Header="Skill Editor">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                   Text="Select a skill, edit the always-visible fields, then commit the skill back to skill.ini."
                                   Opacity="0.75"
                                   Margin="0,0,0,8" />

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="380" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0"
                                      Header="Skills"
                                      Margin="0,0,12,0">
                                        <DockPanel Margin="8">
                                            <StackPanel DockPanel.Dock="Top"
                                                Margin="0,0,0,8">
                                                <TextBox x:Name="SkillSearchBox"
                                                     Height="28"
                                                     TextChanged="SkillSearchBox_TextChanged"
                                                     ToolTip="Search skills by ID, name, or purpose" />

                                                <Button Content="New Skill"
                                                    Height="28"
                                                    Margin="0,8,0,0"
                                                    Click="NewSkillButton_Click" />
                                            </StackPanel>

                                            <DataGrid x:Name="SkillListGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  SelectionMode="Single"
                                                  SelectionChanged="SkillListGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID"
                                                    Binding="{Binding Id}"
                                                    Width="60" />
                                                    <DataGridTextColumn Header="Name"
                                                    Binding="{Binding Name}"
                                                    Width="*" />
                                                    <DataGridTextColumn Header="Purpose"
                                                    Binding="{Binding Purpose}"
                                                    Width="85" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1"
                                        Header="Selected Skill Fields">
                                        <DockPanel Margin="8">
                                            <DockPanel DockPanel.Dock="Top"
                                                Margin="0,0,0,8">
                                                <StackPanel DockPanel.Dock="Right"
                                                        Orientation="Horizontal">
                                                    <Button Content="Commit / Save Skill"
                                                        Width="150"
                                                        Height="28"
                                                        Margin="8,0,0,0"
                                                        Click="CommitSkillButton_Click" />
                                                    <Button Content="Delete Selected"
                                                        Width="120"
                                                        Height="28"
                                                        Margin="8,0,0,0"
                                                        Click="DeleteSkillButton_Click" />
                                                </StackPanel>

                                                <TextBlock x:Name="SelectedSkillText"
                                                   Text="No skill selected."
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                            </DockPanel>

                                            <Grid DockPanel.Dock="Bottom"
                                              Margin="0,8,0,0"
                                              MinHeight="150">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="430" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Expander Grid.Column="0"
                                                  Header="INI Preview"
                                                  IsExpanded="True">
                                                    <TextBox x:Name="SkillRawPreviewText"
                                                         FontFamily="Consolas"
                                                         FontSize="13"
                                                         IsReadOnly="True"
                                                         TextWrapping="NoWrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         MinHeight="130" />
                                                </Expander>

                                                <TextBlock Grid.Column="2"
                                                   Text="Blank value fields are skipped. Checked flags write bare keywords. Usable writes as Usable=1."
                                                   TextWrapping="Wrap"
                                                   Opacity="0.75"
                                                   VerticalAlignment="Top" />
                                            </Grid>

                                            <TabControl>
                                                <TabItem Header="General">
                                                    <DataGrid x:Name="SkillGeneralFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Attributes">
                                                    <DataGrid x:Name="SkillAttributesFieldGrid" />
                                                </TabItem>
                                                <TabItem Header="Flags">
                                                    <DataGrid x:Name="SkillFlagsFieldGrid" />
                                                </TabItem>
                                            </TabControl>
                                        </DockPanel>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Animations -->
                    <Grid x:Name="AnimationView"
                          Visibility="Collapsed">
                        <GroupBox Header="Animation Editor">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Select an animation on the left, then edit its fields and flags on the right."
                                           Opacity="0.75"
                                           Margin="0,0,0,8" />

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="380" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0"
                                              Header="Animations"
                                              Margin="0,0,12,0">
                                        <DockPanel Margin="8">
                                            <TextBox x:Name="AnimationSearchBox"
                                                     DockPanel.Dock="Top"
                                                     Height="28"
                                                     Margin="0,0,0,8"
                                                     TextChanged="AnimationSearchBox_TextChanged"
                                                     ToolTip="Search animations by ID or name" />

                                            <DataGrid x:Name="AnimationListGrid"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single"
                                                      SelectionChanged="AnimationListGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID"
                                                                        Binding="{Binding Id}"
                                                                        Width="70" />
                                                    <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name}"
                                                                        Width="*" />
                                                    <DataGridTextColumn Header="Frames"
                                                                        Binding="{Binding FrameCount}"
                                                                        Width="70" />
                                                    <DataGridTextColumn Header="Issues"
                                                                        Binding="{Binding IssueCount}"
                                                                        Width="70" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1"
                                              Header="Selected Animation Fields">
                                        <DockPanel Margin="8">
                                            <TextBlock x:Name="SelectedAnimationText"
                                               DockPanel.Dock="Top"
                                               Text="No animation selected."
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                            <Border DockPanel.Dock="Top"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="1"
                                                Padding="8"
                                                Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Button Content="Commit / Save Animation"
                                                        Width="170"
                                                        Height="28"
                                                        DockPanel.Dock="Right"
                                                        Click="CommitAnimationButton_Click" />

                                                    <TextBlock Text="Edit frames, sounds, and flags, then commit to animation.ini."
                                                       VerticalAlignment="Center"
                                                       Opacity="0.75" />
                                                </DockPanel>
                                            </Border>

                                            <Expander Header="Raw INI Entry"
                                              IsExpanded="False"
                                              DockPanel.Dock="Top"
                                              Margin="0,0,0,8">
                                                <TextBox x:Name="AnimationRawPreviewText"
                                                     FontFamily="Consolas"
                                                     FontSize="13"
                                                     IsReadOnly="True"
                                                     TextWrapping="NoWrap"
                                                     AcceptsReturn="True"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     MinHeight="120"
                                                     MaxHeight="220" />
                                            </Expander>

                                            <GroupBox Header="Animation Preview"
                                              DockPanel.Dock="Bottom"
                                              Margin="0,8,0,0"
                                              MinHeight="95">
                                                <DockPanel Margin="8">
                                                    <TextBlock x:Name="AnimationPreviewText"
                                                       DockPanel.Dock="Bottom"
                                                       Text="Frames: -"
                                                       Margin="0,8,0,0"
                                                       Opacity="0.75" />

                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                        VerticalScrollBarVisibility="Disabled">
                                                        <StackPanel x:Name="AnimationPreviewStrip"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center" />
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </GroupBox>

                                            <DataGrid x:Name="AnimationFieldGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="True"
                                              CanUserDeleteRows="True"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              CellEditEnding="AnimationFieldGrid_CellEditEnding">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type"
                                                        Binding="{Binding Type}"
                                                        Width="90" />

                                                    <DataGridTextColumn Header="Key / Flag"
                                                        Binding="{Binding Key}"
                                                        Width="220" />

                                                    <DataGridTextColumn Header="Value"
                                                        Binding="{Binding Value}"
                                                        Width="*" />

                                                    <DataGridTemplateColumn Header="Sprite"
                                                        Width="75">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Pick"
                                                                    MinWidth="58"
                                                                    Margin="2"
                                                                    Tag="{Binding}"
                                                                    Loaded="AnimationFramePickButton_Loaded"
                                                                    Click="PickAnimationFrameButton_Click" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridTemplateColumn Header="Sound"
                                                        Width="75">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Pick"
                                                                    MinWidth="58"
                                                                    Margin="2"
                                                                    Tag="{Binding}"
                                                                    Loaded="AnimationSoundPickButton_Loaded"
                                                                    Click="PickAnimationSoundButton_Click" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                    <DataGridCheckBoxColumn Header="Enabled"
                                                        Binding="{Binding Enabled}"
                                                        Width="90" />

                                                    <DataGridTextColumn Header="Known"
                                                        Binding="{Binding KnownText}"
                                                        IsReadOnly="True"
                                                        Width="90" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Treasures -->
                    <Grid x:Name="TreasureView"
                          Visibility="Collapsed">
                        <GroupBox Header="Treasure Editor">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Select a treasure table on the left, then edit its fields on the right."
                                           Opacity="0.75"
                                           Margin="0,0,0,8" />

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="330" />
                                        <ColumnDefinition Width="360" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0"
                                      Header="Treasure Tables"
                                      Margin="0,0,12,0">
                                        <DockPanel Margin="8">
                                            <TextBox x:Name="TreasureSearchBox"
                                                 DockPanel.Dock="Top"
                                                 Height="28"
                                                 Margin="0,0,0,8"
                                                 TextChanged="TreasureSearchBox_TextChanged"
                                                 ToolTip="Search treasure tables by ID or name" />

                                            <DataGrid x:Name="TreasureListGrid"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              SelectionMode="Single"
                                              SelectionChanged="TreasureListGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID"
                                                        Binding="{Binding Id}"
                                                        Width="55" />
                                                    <DataGridTextColumn Header="Name"
                                                        Binding="{Binding Name}"
                                                        Width="*" />
                                                    <DataGridTextColumn Header="Items"
                                                        Binding="{Binding ItemCount}"
                                                        Width="60" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1"
                                      Header="Treasure Entries"
                                      Margin="0,0,12,0">
                                        <DockPanel Margin="8">
                                            <TextBlock x:Name="SelectedTreasureTableText"
                                               DockPanel.Dock="Top"
                                               Text="No treasure table selected."
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                            <StackPanel DockPanel.Dock="Bottom"
                                                    Orientation="Horizontal"
                                                    Margin="0,8,0,0">
                                                <Button Content="New Entry"
                                                    Width="90"
                                                    Height="28"
                                                    Margin="0,0,8,0"
                                                    Click="NewTreasureEntryButton_Click" />
                                                <Button Content="Delete Entry"
                                                    Width="95"
                                                    Height="28"
                                                    Click="DeleteTreasureEntryButton_Click" />
                                            </StackPanel>

                                            <DataGrid x:Name="TreasureEntryGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  SelectionMode="Single"
                                                  SelectionChanged="TreasureEntryGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="#"
                                                        Binding="{Binding EntryIndex}"
                                                        Width="45" />
                                                    <DataGridTextColumn Header="Item"
                                                        Binding="{Binding Item}"
                                                        Width="*" />
                                                    <DataGridTextColumn Header="Skill"
                                                        Binding="{Binding SkillId}"
                                                        Width="90" />
                                                    <DataGridTextColumn Header="Chance"
                                                        Binding="{Binding Chance}"
                                                        Width="70" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="2"
                                        Header="Selected Treasure Entry">
                                        <DockPanel Margin="8">
                                            <TextBlock x:Name="SelectedTreasureEntryText"
                                               DockPanel.Dock="Top"
                                               Text="No treasure entry selected."
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8" />

                                            <Border DockPanel.Dock="Top"
                                                BorderBrush="#DDDDDD"
                                                BorderThickness="1"
                                                Padding="8"
                                                Margin="0,0,0,8">
                                                <DockPanel>
                                                    <Button Content="Commit / Save Entry"
                                                        Width="150"
                                                        Height="28"
                                                        DockPanel.Dock="Right"
                                                        Click="CommitTreasureEntryButton_Click" />

                                                    <TextBlock Text="Edit this treasure entry, then commit to treasure.ini."
                                                       VerticalAlignment="Center"
                                                       Opacity="0.75" />
                                                </DockPanel>
                                            </Border>

                                            <DataGrid x:Name="TreasureEntryFieldGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  SelectionMode="Single">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Field"
                                                        Binding="{Binding Key}"
                                                        IsReadOnly="True"
                                                        Width="180" />

                                                    <DataGridTextColumn Header="Value"
                                                        Binding="{Binding Value}"
                                                        Width="*" />

                                                    <DataGridTemplateColumn Header="Pick"
                                                        Width="75">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <Button Content="Pick"
                                                                    MinWidth="58"
                                                                    Margin="2"
                                                                    Tag="{Binding}"
                                                                    Loaded="TreasureReferencePickButton_Loaded"
                                                                    Click="PickTreasureReferenceButton_Click" />
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>

                                                    <DataGridCheckBoxColumn Header="Enabled"
                                                        Binding="{Binding Enabled}"
                                                        Width="90" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Magic -->
                    <Grid x:Name="MagicView"
                          Visibility="Collapsed">
                        <GroupBox Header="Magic Editor">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Select a spell on the left, then edit its fields and flags on the right."
                                           Opacity="0.75"
                                           Margin="0,0,0,8" />

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="430" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <GroupBox Grid.Column="0"
                                              Header="Spells"
                                              Margin="0,0,12,0">
                                        <DockPanel Margin="8">
                                            <TextBox x:Name="MagicSearchBox"
                                                     DockPanel.Dock="Top"
                                                     Height="28"
                                                     Margin="0,0,0,8"
                                                     TextChanged="MagicSearchBox_TextChanged"
                                                     ToolTip="Search spells by ID, name, or skill" />

                                            <DataGrid x:Name="MagicListGrid"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="False"
                                                      CanUserDeleteRows="False"
                                                      IsReadOnly="True"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single"
                                                      SelectionChanged="MagicListGrid_SelectionChanged">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID"
                                                                        Binding="{Binding Id}"
                                                                        Width="60" />
                                                    <DataGridTextColumn Header="Name"
                                                                        Binding="{Binding Name}"
