                                                                    <DataGrid.Columns>
                                                                        <DataGridTextColumn Header="#"
                                                                            Binding="{Binding Index}"
                                                                            Width="45" />
                                                                        <DataGridTextColumn Header="Treasure"
                                                                            Binding="{Binding Treasure}"
                                                                            Width="*" />
                                                                        <DataGridTextColumn Header="Qty"
                                                                            Binding="{Binding Qty}"
                                                                            Width="65" />
                                                                        <DataGridTextColumn Header="Chance"
                                                                            Binding="{Binding Chance}"
                                                                            Width="80" />
                                                                    </DataGrid.Columns>
                                                                </DataGrid>
                                                            </DockPanel>
                                                        </GroupBox>

                                                        <GroupBox Grid.Column="2"
                                                            Header="Selected Loot Entry">
                                                            <DockPanel Margin="8">
