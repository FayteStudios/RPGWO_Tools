                                                                        Width="110" />
                                                    <DataGridTextColumn Header="Issues"
                                                                        Binding="{Binding IssueCount}"
                                                                        Width="70" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1"
                                              Header="Selected Item Use Fields">
