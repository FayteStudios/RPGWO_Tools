                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single"
                                                      SelectionChanged="MultiUseListGrid_SelectionChanged"
                                                      EnableRowVirtualization="True"
                                                      EnableColumnVirtualization="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="ID"
                                                                        Binding="{Binding Id}"
                                                                        Width="70" />
                                                    <DataGridTextColumn Header="Recipe"
                                                                        Binding="{Binding DisplayName}"
                                                                        Width="*" />
                                                    <DataGridTextColumn Header="Skill"
                                                                        Binding="{Binding Skill}"
                                                                        Width="110" />
                                                    <DataGridTextColumn Header="Issues"
                                                                        Binding="{Binding IssueCount}"
                                                                        Width="70" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>

                                    <GroupBox Grid.Column="1"
                                              Header="Selected Multi Use Fields">
                                        <DockPanel Margin="8">
                                            <TextBlock x:Name="SelectedMultiUseText"
                                                       DockPanel.Dock="Top"
                                                       Text="No multi-use recipe selected."
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,8" />

                                            <Expander Header="Raw INI Entry"
                                                      IsExpanded="False"
                                                      DockPanel.Dock="Top"
                                                      Margin="0,0,0,8">
                                                <TextBox x:Name="MultiUseRawPreviewText"
                                                         FontFamily="Consolas"
                                                         FontSize="13"
                                                         IsReadOnly="True"
                                                         TextWrapping="NoWrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Auto"
                                                         MinHeight="120"
                                                         MaxHeight="220" />
                                            </Expander>

                                            <DataGrid x:Name="MultiUseFieldGrid"
                                                      AutoGenerateColumns="False"
                                                      CanUserAddRows="True"
                                                      CanUserDeleteRows="True"
                                                      HeadersVisibility="Column"
                                                      SelectionMode="Single">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Type"
                                                                        Binding="{Binding Type}"
                                                                        Width="90" />
                                                    <DataGridTextColumn Header="Key / Flag"
                                                                        Binding="{Binding Key}"
                                                                        Width="220" />
                                                    <DataGridTextColumn Header="Value"
                                                                        Binding="{Binding Value}"
                                                                        Width="*" />
                                                    <DataGridCheckBoxColumn Header="Enabled"
                                                                            Binding="{Binding Enabled}"
                                                                            Width="90" />
                                                    <DataGridTextColumn Header="Known"
                                                                        Binding="{Binding KnownText}"
                                                                        IsReadOnly="True"
                                                                        Width="90" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </DockPanel>
                                    </GroupBox>
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <!-- Placeholder -->
                    <Grid x:Name="PlaceholderView"
                          Visibility="Collapsed">
                        <Border BorderThickness="1"
                                BorderBrush="#DDDDDD"
                                CornerRadius="6"
                                Padding="24">
                            <TextBlock x:Name="PlaceholderText"
                                       Text="This editor is not implemented yet."
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Row="1"
                        BorderThickness="1"
                        BorderBrush="#DDDDDD"
                        Padding="12"
                        CornerRadius="6"
                        Margin="0,12,0,0">
                    <TextBlock x:Name="StatusText"
                               Text="Ready."
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>